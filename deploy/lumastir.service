[Unit]
Description=Lumastir LED and motor controller
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Customize account, absolute paths, GPIO/I2C permissions, and Tailnet address.
User=sdl2
WorkingDirectory=/opt/lumastir
Environment=LUMASTIR_CONFIG=/opt/lumastir/configs/3led_3motor.yaml
Environment=LUMASTIR_LOCK_FILE=/run/lock/lumastir.lock
# Provision the venv with the hardware extra BEFORE starting this service.
# Replace the loopback host with this Pi's Tailnet address for remote access.
ExecStart=/opt/lumastir/.venv/bin/lumastir-server --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0077

[Install]
WantedBy=multi-user.target
